{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/COMBINE-lab/seqproc/schemas/seqproc-summary-1.2.0.schema.json",
  "title": "seqproc summary report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seqproc_version",
    "ordering_mode",
    "effective_threads",
    "gzip_compression_level",
    "parallel_gzip_members",
    "parallel_gzip_stream",
    "gzip_compression_threads",
    "gzip_block_size",
    "gzip_input_backend",
    "gzip_input_threads",
    "gzip_input_chunk_size",
    "n_fastqs",
    "n_processed",
    "n_reads_max",
    "total_fragments",
    "accepted_fragments",
    "rejected_fragments",
    "failed_parsing",
    "rejection_reasons",
    "read_length_mean",
    "read_length_min",
    "read_length_max",
    "match_distance_stats"
  ],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "seqproc_version": { "type": "string" },
    "call": { "type": ["string", "null"] },
    "geometry_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9-]+:[0-9a-f]+$"
    },
    "ordering_mode": { "enum": ["input-order", "unordered"] },
    "effective_threads": { "type": "integer", "minimum": 1 },
    "gzip_compression_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "parallel_gzip_members": { "type": "boolean" },
    "parallel_gzip_stream": { "type": "boolean" },
    "gzip_compression_threads": { "type": "integer", "minimum": 1 },
    "gzip_block_size": { "type": "integer", "minimum": 32768 },
    "gzip_input_backend": {
      "enum": ["needletail-auto", "rusty-rapidgzip"]
    },
    "gzip_input_threads": { "type": "integer", "minimum": 1 },
    "gzip_input_chunk_size": { "type": "integer", "minimum": 0 },
    "n_fastqs": { "type": "integer", "minimum": 0 },
    "n_processed": { "type": "integer", "minimum": 0 },
    "n_reads_max": { "type": "integer", "minimum": 0 },
    "total_fragments": { "type": "integer", "minimum": 0 },
    "accepted_fragments": { "type": "integer", "minimum": 0 },
    "rejected_fragments": { "type": "integer", "minimum": 0 },
    "failed_parsing": {
      "type": "integer",
      "minimum": 0,
      "description": "Legacy name retained for compatibility."
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "count"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "read_length_mean": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "read_length_min": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "read_length_max": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "match_distance_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "unmatched", "distance_histogram"],
        "properties": {
          "label": { "type": "string" },
          "unmatched": { "type": "integer", "minimum": 0 },
          "distance_histogram": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["distance", "count"],
              "properties": {
                "distance": { "type": "integer", "minimum": 0 },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
